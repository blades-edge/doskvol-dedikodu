---
import { formatImperialDate } from "@utils/imperial-date";
import PreviewNotice from "@components/PreviewNotice.astro";
import media from "../settings/media.json";
import { imageKey } from "../utils/engraving.mjs";
import Masthead from "@components/Masthead.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import EditorialHead from "./EditorialHead.astro";
import {
  articlesForIssue,
  groupSerialChapters,
  issueSlug,
  type EditorialIndex,
} from "@utils/editorial";
import { articlePath, issuePath } from "@utils/paths";
import { slugifyStr } from "@utils/slugify";

interface Props {
  issue: CollectionEntry<"sayi">;
  publication: EditorialIndex;
}
const { issue, publication } = Astro.props;
const {
  number,
  description,
  imperialDate,
  price,
  leadRows,
  cover,
  coverAlt,
  coverCaption,
} = issue.data;
const imageAssets = import.meta.glob<{
  default: import("astro").ImageMetadata;
}>("../assets/images/*", { eager: true });
const darkCover = media.darkModeImages.some(path =>
  Object.entries(imageAssets).some(
    ([assetPath, asset]) =>
      imageKey(assetPath) === imageKey(path) && asset.default.src === cover?.src
  )
);
const prefix = import.meta.env.BASE_URL;
const articles = articlesForIssue(publication, issue.id);
const lead =
  issue.data.lead && publication.articlesById.get(issue.data.lead.id);
const title = lead?.data.title ?? "Manşet henüz seçilmedi";
const remaining = articles.filter(article => article.id !== lead?.id);
const sections = [
  ...new Set(remaining.map(article => article.data.section)),
].map(name => ({
  name,
  articles: remaining.filter(article => article.data.section === name),
}));
const dateLabel = formatImperialDate(imperialDate);
const position = publication.issues.findIndex(entry => entry.id === issue.id);
const newer = publication.issues[position - 1];
const older = publication.issues[position + 1];
---

<!doctype html>
<html lang="tr">
  <head
    ><EditorialHead
      title={`Sayı ${issueSlug(number)} · ${title}`}
      {description}
      image={cover}
      imageAlt={coverAlt}
      noindex={publication.preview}
    /></head
  >
  <body>
    <PreviewNotice />
    <div class="paper issue-paper">
      <header>
        <Masthead />
        <div class="issue">
          <a href={`${prefix}sayi/`}>Sayı {issueSlug(number)}</a>
          <a href={`${prefix}takvim/`}>{dateLabel}</a>
          <span>Bedeli: {price}</span>
        </div>
        <nav class="nav" aria-label="Yayın bölümleri">
          <a href="#manset">Manşet</a>{
            sections.map(section => (
              <a href={`#${slugifyStr(section.name)}`}>{section.name}</a>
            ))
          }<a href={`${prefix}sayi/`}>Sayı arşivi</a><a
            href={`${prefix}tefrika/`}>Tefrika arşivi</a
          >
        </nav>
      </header>
      <main class="issue-grid">
        <section
          id="manset"
          class="lead"
          style={`--lead-rows: ${leadRows}`}
          aria-labelledby="lead-title"
        >
          {
            lead ? (
              <>
                <div class="eyebrow">
                  Bu sayının manşeti ·{" "}
                  {[lead.data.district, lead.data.location]
                    .filter(Boolean)
                    .join(" · ") || lead.data.section}
                </div>
                <h2 id="lead-title">
                  <a href={`${prefix}${articlePath(lead)}`}>{title}</a>
                </h2>
                <p>{description}</p>
                <div class="byline">
                  — {publication.authorNames(lead.data.author)}
                </div>
              </>
            ) : (
              <>
                <>
                  <h2 id="lead-title">{title}</h2>
                  <p>{description}</p>
                </>
              </>
            )
          }
          {
            cover && (
              <Image
                src={cover}
                alt={coverAlt ?? ""}
                class:list={[
                  "editorial-engraving",
                  { "engraving-dark": darkCover },
                ]}
                widths={[480, 960, 1440, 2060]}
                sizes="(max-width: 32rem) calc(100vw - 1.5rem), min(57rem, calc(92vw - 1rem))"
                loading="eager"
                fetchpriority="high"
              />
            )
          }
          {coverCaption && <div class="caption">{coverCaption}</div>}
        </section>
        {
          sections.map(section => (
            <section aria-labelledby={`${slugifyStr(section.name)}-title`}>
              <h2
                id={`${slugifyStr(section.name)}-title`}
                class="issue-section-title"
              >
                {section.name}
              </h2>
              <div
                class={
                  section.articles.some(article => article.data.series)
                    ? "issue-serials"
                    : "columns"
                }
              >
                {section.articles.some(article => article.data.series)
                  ? groupSerialChapters(section.articles).map(
                      (group, index) => {
                        const series = publication.serialsById.get(
                          group.seriesId
                        )!;
                        return (
                          <article
                            class="serial"
                            id={
                              index === 0 ? slugifyStr(section.name) : undefined
                            }
                          >
                            <div>
                              <div class="eyebrow">Edebiyat ve tefrika</div>
                              <h3>
                                <a href={`${prefix}tefrika/${group.seriesId}/`}>
                                  {series.data.title}
                                </a>
                              </h3>
                            </div>
                            <ol
                              class="serial-chapters"
                              aria-label={`${series.data.title} — bu sayıdaki bölümler`}
                            >
                              {group.chapters.map(chapter => (
                                <li class="serial-chapter">
                                  <h4 class="serial-chapter-title">
                                    <a
                                      href={`${prefix}${articlePath(chapter)}`}
                                    >
                                      Bölüm {chapter.data.episode} ·{" "}
                                      {chapter.data.title}
                                    </a>
                                  </h4>
                                  <p>{chapter.data.description}</p>
                                  <p class="byline">
                                    —{" "}
                                    {publication.authorNames(
                                      chapter.data.author
                                    )}
                                  </p>
                                  <a
                                    class="reading-link"
                                    href={`${prefix}${articlePath(chapter)}`}
                                  >
                                    Bölümü oku <span aria-hidden="true">→</span>
                                  </a>
                                </li>
                              ))}
                            </ol>
                          </article>
                        );
                      }
                    )
                  : section.articles.map((article, index) => (
                      <article
                        class="story"
                        id={index === 0 ? slugifyStr(section.name) : undefined}
                      >
                        <div class="eyebrow">
                          {[article.data.district, article.data.location]
                            .filter(Boolean)
                            .join(" · ") || article.data.section}
                        </div>
                        <h3>
                          <a href={`${prefix}${articlePath(article)}`}>
                            {article.data.title}
                          </a>
                        </h3>
                        <p>{article.data.description}</p>
                        <div class="byline">
                          — {publication.authorNames(article.data.author)}
                        </div>
                      </article>
                    ))}
              </div>
            </section>
          ))
        }
        <nav class="reading-return" aria-label="Sayılar arasında gezinme">
          {
            older ? (
              <a href={`${prefix}${issuePath(older.data.number)}`}>
                ← Sayı {issueSlug(older.data.number)}
              </a>
            ) : (
              <span>İlk sayı</span>
            )
          }
          <a href={`${prefix}sayi/`}>Bütün sayılar</a>
          {
            newer ? (
              <a href={`${prefix}${issuePath(newer.data.number)}`}>
                Sayı {issueSlug(newer.data.number)} →
              </a>
            ) : (
              <span>En yeni sayı</span>
            )
          }
        </nav>
      </main>
      <footer>
        Doskvol Dedikoduları · Duyduğunuza inanmayın. Duymadıklarınızdan korkun.
      </footer>
    </div>
  </body>
</html>
