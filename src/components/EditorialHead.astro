---
import "@styles/editorial.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultCover from "@assets/images/doskvol-line-engraving.png";
import { SITE } from "../config";

interface Props {
  title: string;
  noindex?: boolean;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
}

const {
  title,
  noindex = false,
  description = SITE.desc,
  image = defaultCover,
  imageAlt = "Doskvol’da kanal kıyısındaki yapılar; mürekkep çizgileriyle gravür.",
  type = "website",
} = Astro.props;
const pageTitle = `${title} | ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = await getImage({ src: image, width: 1200, format: "png" });
const imageUrl = new URL(shareImage.src, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  (() => {
    const key = "doskvol-appearance";
    const valid = value => ["day", "night", "device"].includes(value);
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    let preference = "device";
    try {
      const saved = localStorage.getItem(key);
      if (valid(saved)) preference = saved;
    } catch {
      // Private browsing may deny storage; the current page still works.
    }
    const paint = () => {
      const dark =
        preference === "night" || (preference === "device" && media.matches);
      document.documentElement.dataset.theme = dark ? "dark" : "light";
      document.querySelectorAll("[data-theme-choice]").forEach(button => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.themeChoice === preference)
        );
      });
    };
    paint();
    document.addEventListener("DOMContentLoaded", paint, { once: true });
    media.addEventListener("change", paint);
    document.addEventListener("doskvol:theme", event => {
      if (!valid(event.detail)) return;
      preference = event.detail;
      try {
        localStorage.setItem(key, preference);
      } catch {
        // Private browsing may deny storage; the current page still works.
      }
      paint();
    });
    window.addEventListener("storage", event => {
      if (event.key !== key && event.key !== null) return;
      preference = valid(event.newValue) ? event.newValue : "device";
      paint();
    });
  })();
</script>
<link
  rel="icon"
  type="image/svg+xml"
  href={`${import.meta.env.BASE_URL}favicon.svg`}
/>
{
  (noindex || import.meta.env.BASE_URL.includes("/taslak/pr-")) && (
    <meta name="robots" content="noindex, nofollow" />
  )
}
<link rel="canonical" href={canonical} />
<meta name="description" content={description} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
  rel="stylesheet"
/>
<title>{pageTitle}</title>
