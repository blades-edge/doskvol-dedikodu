---
import { Image } from "astro:assets";
import day from "@assets/images/weather-day.png";
import night from "@assets/images/weather-night.png";
import device from "@assets/images/weather-device.png";
const choices = [
  {
    value: "day",
    label: "Gündüz",
    title: "Kırık güneş — açık görünüm",
    image: day,
  },
  {
    value: "night",
    label: "Gece",
    title: "Ay ve sönük yansımaları — koyu görünüm",
    image: night,
  },
  {
    value: "device",
    label: "Cihaz",
    title: "Hayaletli hava — cihazın tercihini izle",
    image: device,
  },
];
---

<aside class="weather-theme" aria-label="Gazetenin hava durumu ve görünümü">
  <div class="weather-caption">Doskvol’da hava</div>
  <div class="weather-choices" role="group" aria-label="Görünüm tercihi">
    {
      choices.map(choice => (
        <button
          type="button"
          data-theme-choice={choice.value}
          aria-pressed={choice.value === "device" ? "true" : "false"}
          title={choice.title}
        >
          <Image
            src={choice.image}
            alt=""
            width={56}
            height={56}
            loading="eager"
          />
          <span>{choice.label}</span>
        </button>
      ))
    }
  </div>
</aside>
<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-choice]")
    .forEach(button => {
      button.addEventListener("click", () => {
        document.dispatchEvent(
          new CustomEvent("doskvol:theme", {
            detail: button.dataset.themeChoice,
          })
        );
      });
    });
</script>
