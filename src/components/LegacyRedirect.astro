---
interface Props {
  target: string;
}
const { target } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Adres değişti · Doskvol Dedikoduları</title>
  </head>
  <body
    ><p>
      Bu sayfanın adresi değişti. <a href={target}>Yeni adresi aç</a>.
    </p></body
  >
</html>
