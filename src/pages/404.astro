---
import EditorialHead from "@components/EditorialHead.astro";
---

<html lang="tr">
  <head><EditorialHead title="Sayfa bulunamadı" /></head>
  <body>
    <main class="missing-page">
      <p>Doskvol Dedikoduları · 404</p>
      <h1>Bu sayfa kayıplara karışmış.</h1>
      <p><a href={import.meta.env.BASE_URL}>Son sayıya dön</a></p>
    </main>
    <style>
      .missing-page {
        max-width: 42rem;
        margin: 5rem auto;
        padding: 1.5rem;
      }
    </style>
  </body>
</html>
