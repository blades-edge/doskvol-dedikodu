---
import EditorialIssue from "@components/EditorialIssue.astro";
import { getIssuePreviews, issueSlug } from "@utils/editorial";
export async function getStaticPaths() {
  return (await getIssuePreviews()).map(({ issue, publication }) => ({
    params: { issue: issueSlug(issue.data.number) },
    props: { issue, publication },
  }));
}
const { issue, publication } = Astro.props;
---

<EditorialIssue {issue} {publication} />
