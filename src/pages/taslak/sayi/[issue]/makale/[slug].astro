---
import { render } from "astro:content";
import EditorialReading from "@layouts/EditorialReading.astro";
import { getIssuePreviews, issueSlug } from "@utils/editorial";
export async function getStaticPaths() {
  return (await getIssuePreviews()).flatMap(({ issue, publication }) =>
    publication.articles
      .filter(article => !article.data.series)
      .map(article => ({
        params: { issue: issueSlug(issue.data.number), slug: article.id },
        props: { article, publication },
      }))
  );
}
const { article, publication } = Astro.props;
const { Content } = await render(article);
---

<EditorialReading {article} {publication}><Content /></EditorialReading>
