---
import { render } from "astro:content";
import EditorialReading from "@layouts/EditorialReading.astro";
import { getEditorial } from "@utils/editorial";
export async function getStaticPaths() {
  const publication = await getEditorial();
  return publication.articles
    .filter(article => article.data.series)
    .map(article => ({
      params: {
        series: article.data.series!.id,
        episode: String(article.data.episode),
      },
      props: { article, publication },
    }));
}
const { article, publication } = Astro.props;
const { Content } = await render(article);
---

<EditorialReading {article} {publication}><Content /></EditorialReading>
