---
import { issuePath } from "@utils/paths";
import WeatherTheme from "@components/WeatherTheme.astro";
import EditorialHead from "@components/EditorialHead.astro";
import { getEditorial, issueSlug, articlesForIssue } from "@utils/editorial";
const publication = await getEditorial();
const prefix = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="tr">
  <head><EditorialHead title="Sayı arşivi" /></head>
  <body>
    <div class="paper reading-paper">
      <header class="masthead reading-masthead">
        <div class="masthead-title">
          <div class="eyebrow">Akoros’un bağımsız sesi · Doskvol</div><a
            class="reading-wordmark"
            href={prefix}>Doskvol Dedikoduları</a
          ><div class="tagline">Şehrin hafızası, sayı sayı.</div>
        </div>
        <WeatherTheme />
      </header>
      <main>
        <header class="reading-heading">
          <div class="eyebrow">Bütün baskılar</div><h1>Sayı arşivi</h1><p
            class="reading-deck"
          >
            Haberler, dedikodular ve yarım kalan hikâyeler. Her sayı kendi
            gecesini saklar.
          </p>
        </header>
        <ol class="issue-archive">
          {
            publication.issues.map(issue => (
              <li>
                <article>
                  <>
                    <div class="eyebrow">
                      Sayı {issueSlug(issue.data.number)} ·{" "}
                      <time datetime={issue.data.date.toISOString()}>
                        {issue.data.date.toLocaleDateString("tr-TR", {
                          dateStyle: "long",
                          timeZone: "UTC",
                        })}
                      </time>
                    </div>
                    <h2>
                      <a href={`${prefix}${issuePath(issue.data.number)}`}>
                        {(issue.data.lead &&
                          publication.articlesById.get(issue.data.lead.id)?.data
                            .title) ||
                          "Manşet henüz seçilmedi"}
                      </a>
                    </h2>
                    <p>{issue.data.description}</p>
                    <div class="byline">
                      {articlesForIssue(publication, issue.id).length} makale ·{" "}
                      {
                        new Set(
                          articlesForIssue(publication, issue.id).map(
                            article => article.data.author.id
                          )
                        ).size
                      }{" "}
                      yazar
                    </div>
                  </>
                </article>
              </li>
            ))
          }
        </ol>
      </main>
      <footer><a href={prefix}>En yeni sayıya dön</a></footer>
    </div>
  </body>
</html>
