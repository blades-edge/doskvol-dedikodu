---
import { Image } from "astro:assets";
import engraving from "@assets/images/doskvol-line-engraving.png";
import EditorialHead from "@components/EditorialHead.astro";

const headlines = [
  {
    section: "İPEKYALI",
    title: "Kızıl Kuşaklar Okulu’nda gece yarısı ziyareti",
    href: `${import.meta.env.BASE_URL}editorial-preview/gece-yarisi-ziyareti/`,
    desc: "Üç isimsiz konuk, ters çalışan bir saat ve sabaha karşı susturulan bir zil. Okul yönetimi açıklama yapmayı reddediyor.",
    byline: "Özel Muhabir",
  },
  {
    section: "RIHTIM",
    title: "Sislerin Arasında Kaybolan Bir Yük",
    desc: "Liman işçileri kayıtlara geçmeyen sandıklar hakkında konuşmaktan kaçınıyor.",
    byline: "Rıhtım Muhabirimiz",
  },
  {
    section: "ŞEHİRDEN",
    title: "Yağkaralarının Yeni İşletmesi Hakkında Söylentiler",
    desc: "İpekyalı'daki bir binada geceleri duyulan sesler komşuları huzursuz ediyor.",
    byline: "İsimsiz Bir Tanık",
  },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <EditorialHead title="Tasarım prototipi" />
  </head>
  <body>
    <div class="notice">
      Tasarım denemesi · Gerçek yayın sayfası değildir · İçerikler yer
      tutucudur.
    </div>
    <div class="paper">
      <header>
        <div class="masthead">
          <div class="eyebrow">Akoros'un bağımsız sesi · Doskvol</div>
          <h1>Doskvol<br />Dedikoduları</h1>
          <div class="tagline">
            Duyduğunuza inanmayın. Duymadıklarınızdan korkun.
          </div>
        </div>
        <div class="issue">
          <span>Sayı 001</span><span>Şehrin karanlık sokaklarından</span><span
            >Bedeli: 2 mangır</span
          >
        </div>
        <nav class="nav" aria-label="Yayın bölümleri">
          <a href="#manset">Manşet</a><a href="#dedikodular">Dedikodular</a><a
            href="#tefrika">Tefrika</a
          >
        </nav>
      </header>
      <main>
        <section id="manset" class="lead" aria-labelledby="lead-title">
          <div class="eyebrow">Bu haftanın manşeti · Özel haber</div>
          <h2 id="lead-title">
            <a
              href={`${import.meta.env.BASE_URL}editorial-preview/gece-yarisi-ziyareti/`}
              >Sis çöktü, şehir konuşmaya başladı</a
            >
          </h2>
          <p>
            Kızıl Kuşaklar Okulu’nun kapıları gece yarısından sonra üç kez
            açıldı. İçeri girenlerin adları yoktu; çıkışlarıysa hiçbir deftere
            yazılmadı.
          </p>
          <Image
            src={engraving}
            alt="Sisli bir kanalın kıyısındaki karanlık taş yapılar, köprüler ve uzaktaki fabrika bacaları; ortada kapısı aydınlık eski bir okul."
            class="editorial-engraving"
            widths={[480, 960, 1440, 2060]}
            sizes="(max-width: 720px) calc(100vw - 3rem), (max-width: 1160px) 92vw, 1046px"
            loading="eager"
            fetchpriority="high"
          />
          <div class="caption">
            Doskvol’da gece — gazete için hazırlanmış temsili gravür.
          </div>
        </section>
        <section id="dedikodular" aria-label="Dedikodular">
          <div class="eyebrow" style="margin-top:1.5rem">
            Şehirden haberler ve dedikodular
          </div>
          <div class="columns">
            {
              headlines.map(item => (
                <article class="story">
                  <div class="eyebrow">{item.section}</div>
                  <h3>
                    {"href" in item ? (
                      <a href={item.href}>{item.title}</a>
                    ) : (
                      item.title
                    )}
                  </h3>
                  <p>{item.desc}</p>
                  <div class="byline">— {item.byline}</div>
                </article>
              ))
            }
          </div>
        </section>
        <section id="tefrika" class="serial" aria-labelledby="serial-title">
          <div>
            <div class="eyebrow">Edebiyat ve tefrika</div><div
              class="marker"
              aria-hidden="true"
            >
              ❦
            </div><h2 id="serial-title">
              <a
                href={`${import.meta.env.BASE_URL}editorial-preview/kor-noktanin-guncesi/`}
                >Kör Nokta’nın Güncesi</a
              >
            </h2>
          </div>
          <div>
            <div class="eyebrow">Birinci bölüm · Oyun günlüğü</div><p>
              Bana, okuldan bir defter almamı söylediler. Bir sayfa koparmamamı,
              kapağını açmamamı, içinden adım okunursa cevap vermememi de.
              Ücretin yarısını peşin aldığımda yalnızca ilk iki şartı duymuştum.
            </p><p class="byline">Birinci bölüm: Adımı bilen kapı</p>
            <a
              class="reading-link"
              href={`${import.meta.env.BASE_URL}editorial-preview/kor-noktanin-guncesi/`}
              >Birinci bölümü oku <span aria-hidden="true">→</span></a
            >
          </div>
        </section>
      </main>
      <footer>Doskvol Dedikoduları · Mürekkep kurumadan okuyanlara</footer>
    </div>
  </body>
</html>
