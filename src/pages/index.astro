---
import EditorialIssue from "@components/EditorialIssue.astro";
import { getEditorial } from "@utils/editorial";
const publication = await getEditorial();
const latest = publication.issues[0];
if (!latest)
  throw new Error("Gazete için en az bir yayıma hazır sayı ekleyin.");
---

<EditorialIssue issue={latest} {publication} />
