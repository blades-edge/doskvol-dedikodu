---
import LegacyRedirect from "@components/LegacyRedirect.astro";
import { getEditorial } from "@utils/editorial";
import { articlePath } from "@utils/paths";
export async function getStaticPaths() {
  const publication = await getEditorial();
  return publication.articles.map(article => ({
    params: { slug: article.id },
    props: { target: articlePath(article) },
  }));
}
const { target } = Astro.props;
---

<LegacyRedirect target={`${import.meta.env.BASE_URL}${target}`} />
