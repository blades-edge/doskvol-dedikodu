---
import LegacyRedirect from "@components/LegacyRedirect.astro";
import { getEditorial, issueSlug } from "@utils/editorial";
import { issuePath } from "@utils/paths";
export async function getStaticPaths() {
  const publication = await getEditorial();
  return publication.issues.map(issue => ({
    params: { issue: issueSlug(issue.data.number) },
    props: { target: issuePath(issue.data.number) },
  }));
}
const { target } = Astro.props;
---

<LegacyRedirect target={`${import.meta.env.BASE_URL}${target}`} />
