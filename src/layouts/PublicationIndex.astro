---
import EditorialHead from "@components/EditorialHead.astro";
import Masthead from "@components/Masthead.astro";
import type { ImageMetadata } from "astro";
interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, description, image, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="tr">
  <head><EditorialHead {title} {description} {image} {imageAlt} /></head>
  <body>
    <div class="paper reading-paper">
      <Masthead href={base} />
      <main>
        <header class="reading-heading">
          <h1>{title}</h1>{
            description && <p class="reading-deck">{description}</p>
          }
        </header>
        <slot />
      </main>
      <footer>
        <a href={base}>Son sayı</a> · <a href={`${base}sayi/`}>Sayı arşivi</a> · <a
          href={`${base}tefrika/`}>Tefrika</a
        >
      </footer>
    </div>
  </body>
</html>
