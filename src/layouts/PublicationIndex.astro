---
import EditorialHead from "@components/EditorialHead.astro";
import WeatherTheme from "@components/WeatherTheme.astro";
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="tr">
  <head><EditorialHead {title} /></head>
  <body>
    <div class="paper reading-paper">
      <header class="masthead reading-masthead">
        <div class="masthead-title">
          <div class="eyebrow">Akoros’un bağımsız sesi · Doskvol</div>
          <a class="reading-wordmark" href={base}>Doskvol Dedikoduları</a>
          <div class="tagline">Mürekkep kurumadan okuyanlara.</div>
        </div>
        <WeatherTheme />
      </header>
      <main>
        <header class="reading-heading">
          <h1>{title}</h1>{
            description && <p class="reading-deck">{description}</p>
          }
        </header>
        <slot />
      </main>
      <footer>
        <a href={base}>Son sayı</a> · <a href={`${base}sayi/`}>Sayı arşivi</a> · <a
          href={`${base}tefrika/`}>Tefrika</a
        >
      </footer>
    </div>
  </body>
</html>
